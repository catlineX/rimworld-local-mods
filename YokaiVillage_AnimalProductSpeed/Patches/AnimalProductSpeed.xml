<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- Nine-tail: 30-day shearing interval -> 3 days, 10x frequency. -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="Yokai_NineTail"]/comps/li[contains(@Class,"CompProperties_Shearable")]/shearIntervalDays</xpath>
    <value>
      <shearIntervalDays>3</shearIntervalDays>
    </value>
  </Operation>

  <!-- Yuki Shizuku / 月牙精灵: 5000 points -> 100 points, 50x progress. -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="Yokai_YukiShizuku"]/comps/li[contains(@Class,"YokaiCompProperties_SpawnThing")]/dropThingAndNeedPoint/needPoint</xpath>
    <value>
      <needPoint>100</needPoint>
    </value>
  </Operation>

  <!-- Tusk spirit: 135000 points -> 2700 points, 50x production. The DefName is misspelled as Yokai_TuskSprit in the original mod. -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="Yokai_TuskSprit"]/comps/li[contains(@Class,"YokaiCompProperties_SpawnThing")]/dropThingAndNeedPoint/needPoint</xpath>
    <value>
      <needPoint>2700</needPoint>
    </value>
  </Operation>

  <!-- Hiirokabe / 日绯色壁: 15-day shearing interval -> 1.5 days, 10x frequency. -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="Yokai_HihiiroKabe"]/comps/li[contains(@Class,"CompProperties_Shearable")]/shearIntervalDays</xpath>
    <value>
      <shearIntervalDays>1.5</shearIntervalDays>
    </value>
  </Operation>
  <!-- Tenaga and TenagaH: hair threshold 5000 -> 2500, 2x frequency; batch sizes unchanged. -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="Yokai_Tenaga" or defName="Yokai_TenagaH"]/comps/li[contains(@Class,"YokaiCompProperties_SpawnThing")]/dropThingAndNeedPoint[thingDef="Yokai_TenagaHair"]/needPoint</xpath>
    <value>
      <needPoint>2500</needPoint>
    </value>
  </Operation>
</Patch>
