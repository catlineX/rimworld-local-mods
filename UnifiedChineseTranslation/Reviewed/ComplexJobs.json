    {
      "key": "FrozenSnowFoxComplexJobsSettings.label",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "FSF复杂工作"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.1.text",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "修改设置后需重启游戏。\n若在已有存档中启用新的工作类型，现有机械体需要重新替换才能获得新工作类型。"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.4.text",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "复杂工作设置"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.6.label",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "将异常研究相关工作归入黑暗研究"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.8.text",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "将其他工作类型中的Anomaly任务移入黑暗研究，并把社交能力纳入该工作类型的要求。"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.11.label",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "征召时执行工作"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.13.text",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "允许征召状态下执行工作，无需反复取消征召和重新征召。\n注意：少数任务仍可能无法在征召时执行，或会强制取消征召。"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.16.label",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "灭火工作包含救援"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.18.text",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "为灭火工作添加救援任务，使执行灭火工作的角色先救援倒地友军，再灭火。\n注意：虽然它可替代独立救援工作类型，但两项同时启用也没有问题。"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.21.label",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "解除理念角色的工作及武器限制"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.23.text",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "移除所有理念角色禁用的工作类型和武器限制。"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.26.label",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "允许机械体执行更多工作"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.28.text",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "将工作任务的canBeDoneByMechs由false改为true。\n注意：部分任务缺少额外代码补丁时会破坏游戏，因此不包含这些任务。"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.31.label",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "允许奴隶执行更多工作"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.33.text",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "允许奴隶执行除看守以外的全部工作类型。"
    },
    {
      "key": "FrozenSnowFoxComplexJobsSettings.settings.41.label",
      "kind": "DefInjected",
      "defType": "XmlExtensions.SettingsMenuDef",
      "text": "独立清除污染工作"
    },
