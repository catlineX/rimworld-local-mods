      "kind": "DefInjected",
      "defType": "PreceptDef",
      "text": "崇敬"
    },
    {
      "key": "HAR_AlienRaces_Exalted.description",
      "kind": "DefInjected",
      "defType": "PreceptDef",
      "text": "来自其他恒星系的异族非同凡响；能成为友善的东道主是我们的荣幸。"
    },
    {
      "key": "HAR_AlienRaces_Exalted.stages.0.label",
      "kind": "DefInjected",
      "defType": "ThoughtDef",
      "text": "了不起的异族！"
    },
    {
      "key": "HAR_AlienRaces_Exalted.stages.0.description",
      "kind": "DefInjected",
      "defType": "ThoughtDef",
      "text": "真不敢相信，我竟能与其他种族相伴！"
    },
