    {
      "key": "HAR_Xenophobia.degreeDatas.0.label",
      "kind": "DefInjected",
      "defType": "TraitDef",
      "text": "仇视异族"
    },
    {
      "key": "HAR_Xenophobia.degreeDatas.0.description",
      "kind": "DefInjected",
      "defType": "TraitDef",
      "text": "[PAWN_nameDef]厌恶且不信任异族，认为他们与动物无异。"
    },
    {
      "key": "HAR_Xenophobia.degreeDatas.1.label",
      "kind": "DefInjected",
      "defType": "TraitDef",
      "text": "喜爱异族"
    },
    {
      "key": "HAR_Xenophobia.degreeDatas.1.description",
      "kind": "DefInjected",
      "defType": "TraitDef",
      "text": "[PAWN_nameDef]认为异族新奇有趣，乐于进一步了解他们，也不介意与他们建立关系。"
    },
    {
      "key": "HAR_Xenophilia.label",
      "kind": "DefInjected",
      "defType": "MemeDef",
      "text": "亲异族主义"
    },
    {
      "key": "HAR_Xenophilia.description",
      "kind": "DefInjected",
      "defType": "MemeDef",
      "text": "应鼓励并接纳与异族的交往；对他们恐惧或敌视，只能证明自己思想狭隘。"
    },
    {
